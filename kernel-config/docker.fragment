# Fragmento de kernel para o Docker, aplicado sobre o bcm2711_defconfig (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES)
#
# O container não tem kernel próprio: usa o da Pi. Se faltar recurso aqui, o dockerd não sobe, a rede bizas-net não é
# criada ou a porta 80 não é publicada. O bcm2711_defconfig já traz quase tudo; este arquivo garante o essencial
#
# "=y" é um pedido, não uma garantia: o kconfig rebaixa a opção para "=m" quando uma dependência dela é módulo (é o caso
# de CONFIG_BRIDGE, que depende de IPV6, módulo no bcm2711_defconfig). Como módulo também funciona: a imagem tem kmod
# (BR2_PACKAGE_KMOD do defconfig da Pi) e o dockerd carrega o que precisa por modprobe
#
# Conferência que falta: o contrib/check-config.sh do docker-engine contra o .config do kernel gerado

# Namespaces: isolamento de processos, rede, hostname e IPC
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# Control groups: limites de CPU, memória e processos (o --pids-limit usa CGROUP_PIDS)
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
# cgroup v2: o controle de dispositivos do runc usa eBPF
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Recursos gerais de container (seccomp é usado pelo perfil padrão do Docker)
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Rede: veth e bridge (docker0 e a rede bizas-net)
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# Netfilter e NAT: publicação da porta 80 → 5000. O iptables do Buildroot é o legacy (xtables), daí os IP_NF_*
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_RAW=y

# Armazenamento: driver overlay2
CONFIG_OVERLAY_FS=y
