# Única fonte das versões e nomes dos containers; lido pelos scripts de build, de teste e pelo provisionamento na placa.
# Tag fixa, nunca "latest"
VERSION=0.5a
IMG_VALIDATOR=bizas-validator
IMG_SERVER=bizas-server
NETWORK=bizas-net
VOLUME=bizas-data
# golang fixado pelo digest do índice multi-arquitetura (docker buildx imagetools inspect)
GOLANG_IMAGE=golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18
